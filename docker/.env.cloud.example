# Copy to docker/.env.cloud on the target host. Never commit that file.
# Every replace-* value is a placeholder and must be replaced before startup.

COMPOSE_PROJECT_NAME=trinyx-cloud
TRINYX_CLOUD_IMAGE_TAG=local

# Canonical public origins. Production keeps these defaults. Every staging
# deployment MUST override all three with its staging origins so OAuth,
# webhooks, assertions and browser redirects never target production.
CLOUD_PUBLIC_URL=https://cloud.trinyx.fr
KEYCLOAK_PUBLIC_URL=https://auth.trinyx.fr
PAID_PUBLIC_URL=https://app.trinyx.fr

# Only the host TLS proxy should reach these loopback listeners.
CLOUD_EDGE_BIND=127.0.0.1
CLOUD_EDGE_PORT=8188
KEYCLOAK_EDGE_BIND=127.0.0.1
KEYCLOAK_EDGE_PORT=8280
# Keep loopback for local validation. In staging set only the EC2 private VPC address
# and restrict port 8443 to the paid-monolith security group.
CLOUD_INTERNAL_BIND=127.0.0.1
CLOUD_INTERNAL_PORT=8443
CLOUD_INTERNAL_HOST=cloud-internal.trinyx.private

CLOUD_DB_NAME=trinyx_cloud
CLOUD_DB_USERNAME=trinyx_cloud
CLOUD_DB_PASSWORD=replace-with-a-long-random-postgres-password
CLOUD_DB_POOL_MAX=10
CLOUD_DB_POOL_MIN=1

CLOUD_REDIS_PASSWORD=replace-with-a-long-random-redis-password
CLOUD_MINIO_ROOT_USER=replace-with-a-random-minio-access-key
CLOUD_MINIO_ROOT_PASSWORD=replace-with-a-long-random-minio-secret-key
CLOUD_MINIO_BUCKET=trinyx-cloud-files

KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.7.1
KEYCLOAK_REALM_NAME=trinyx
KEYCLOAK_FRONTEND_CLIENT_ID=trinyx-frontend
KEYCLOAK_ADMIN_CLIENT_ID=trinyx-admin-api
KEYCLOAK_ADMIN_CLIENT_SECRET=replace-with-a-long-random-keycloak-client-secret
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=replace-with-a-non-default-admin-name
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-admin-password

# Shared HMAC generated only by gateway-service for downstream microservices.
# HMAC v1 is disabled in the Cloud stack.
CLOUD_GATEWAY_SECRET_KEY=replace-with-at-least-32-random-bytes
TRINYX_TENANT_DELEGATION_SECRET=replace-with-at-least-32-random-bytes
# Preserve the existing LiveContext 50 MiB storage upload contract end to end.
CLOUD_GATEWAY_MAX_BODY_BYTES=52428800
CLOUD_GATEWAY_MAX_BUFFERED_REQUESTS=8
CLOUD_GATEWAY_RATE_LIMIT_REQUESTS=120
CLOUD_GATEWAY_RATE_LIMIT_WINDOW_MS=60000
AUDIT_HMAC_KEY=replace-with-base64-encoded-32-plus-random-bytes
AUDIT_UA_PEPPER=replace-with-base64-encoded-32-plus-random-bytes
MODEL_AUDIT_HMAC_KEY=replace-with-a-long-random-model-audit-key
STORAGE_SHOWCASE_HMAC_SECRET=replace-with-at-least-32-random-bytes

CREDENTIAL_ENCRYPTION_PASSWORD=replace-with-a-long-random-encryption-password
CREDENTIAL_ENCRYPTION_SALT=replace-with-a-random-encryption-salt

# CE cloud-link IP privacy HMAC key rotation.
# Keep V1 stable while current version is 1; do not regenerate it on restart.
IP_HASH_HMAC_KEY_V1=replace-with-at-least-32-random-bytes
IP_HASH_HMAC_KEY_V2=
KEY_HMAC_CURRENT_VERSION=1

SMTP_HOST=replace-with-smtp-host
SMTP_PORT=587
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=noreply@trinyx.fr

# Supply the real multiline signing material through the production secret
# manager. The values below exist only so docker compose config can render.
CATALOG_BUNDLE_SIGNING_KEY_PEM=replace-with-external-private-signing-key-pem
CATALOG_BUNDLE_SIGNING_PUBLIC_KEY=replace-with-external-public-signing-key-pem
CATALOG_BUNDLE_SIGNING_KEY_ID=trinyx-cloud-1
CATALOG_BUNDLE_ISSUER=trinyx-cloud

# Ed25519 public verification rings: kid=base64-X509;kid2=base64-X509.
# The matching private keys live only on the paid-monolith authority.
TRINYX_IDENTITY_VERIFICATION_KEYS=authority-identity-1=replace-with-base64-x509-public-key
TRINYX_ENTITLEMENT_VERIFICATION_KEYS=authority-entitlement-1=replace-with-base64-x509-public-key

# Separate Ed25519 workload domain. Cloud signs wallet calls with its private
# key and verifies projection pushes with the paid authority public key.
TRINYX_S2S_SIGNING_KID=cloud-runtime-1
TRINYX_S2S_SIGNING_KEY=replace-with-base64-pkcs8-private-key
TRINYX_S2S_VERIFICATION_KEYS=paid-authority-1=replace-with-base64-x509-public-key
# Private VPC-only paid authority edge. Never point this at app.trinyx.fr.
# Its certificate/CA must be trusted by Cloud JVMs.
PAID_MONOLITH_BILLING_URL=https://billing-internal.trinyx.private
# PKCS12 truststore containing the CA/certificate used by the private paid edge.
PAID_MONOLITH_TRUSTSTORE_PATH=/absolute/host/path/to/paid-monolith-truststore.p12
# File containing only the truststore password. Keep it outside Git with restrictive permissions.
PAID_MONOLITH_TRUSTSTORE_PASSWORD_PATH=/absolute/host/path/to/paid-monolith-truststore-password

WEBSEARCH_GATEWAY_SECRET=replace-with-at-least-32-random-bytes
WEBSEARCH_CDP_JWT_SECRET=replace-with-at-least-32-random-bytes
SEARXNG_SECRET=replace-with-at-least-32-random-bytes

# Optional managed-Cloud provider credentials. The Compose file forwards every
# provider that CloudRelaySupport can execute; a blank key keeps that provider
# unavailable and Native Model Discovery skips it without failing the sync.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# Legacy Google/Gemini alias retained for provider compatibility.
GEMINI_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
PERPLEXITY_API_KEY=
COHERE_API_KEY=
ZAI_API_KEY=
OPENROUTER_API_KEY=
QWEN_API_KEY=
MOONSHOT_API_KEY=
MINIMAX_API_KEY=
# International MiniMax endpoint. Mainland China uses a different host and key.
MINIMAX_API_URL=https://api.minimax.io/v1/chat/completions

# Remote code execution is disabled by default. The repository does not ship a
# compatible Piston service. To enable code nodes, set PISTON_ENABLED=true and
# provide a reviewed private HTTP(S) endpoint; never use a fake URL just to render Compose.
PISTON_ENABLED=false
PISTON_URL=


# Distinct internal service identities (minimum 32 random characters each).
# Never reuse a value: the target service selects the verification key by serviceId.
CATALOG_SERVICE_S2S_SECRET=replace-with-32-plus-random-characters
ORCHESTRATOR_SERVICE_S2S_SECRET=replace-with-32-plus-random-characters
AGENT_SERVICE_S2S_SECRET=replace-with-32-plus-random-characters
DATASOURCE_SERVICE_S2S_SECRET=replace-with-32-plus-random-characters
INTERFACE_SERVICE_S2S_SECRET=replace-with-32-plus-random-characters
STORAGE_SERVICE_S2S_SECRET=replace-with-32-plus-random-characters
TRIGGER_SERVICE_S2S_SECRET=replace-with-32-plus-random-characters
PUBLICATION_SERVICE_S2S_SECRET=replace-with-32-plus-random-characters
AUTH_SERVICE_S2S_SECRET=replace-with-32-plus-random-characters
GATEWAY_SERVICE_S2S_SECRET=replace-with-32-plus-random-characters
