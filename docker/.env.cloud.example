# Copy to docker/.env.cloud on the target host. Never commit that file.
# Every replace-* value is a placeholder and must be replaced before startup.

COMPOSE_PROJECT_NAME=trinyx-cloud
TRINYX_CLOUD_IMAGE_TAG=local

# Only the host TLS proxy should reach these loopback listeners.
CLOUD_EDGE_BIND=127.0.0.1
CLOUD_EDGE_PORT=8188
KEYCLOAK_EDGE_BIND=127.0.0.1
KEYCLOAK_EDGE_PORT=8280

CLOUD_DB_NAME=trinyx_cloud
CLOUD_DB_USERNAME=trinyx_cloud
CLOUD_DB_PASSWORD=replace-with-a-long-random-postgres-password
CLOUD_DB_POOL_MAX=10
CLOUD_DB_POOL_MIN=1

CLOUD_REDIS_PASSWORD=replace-with-a-long-random-redis-password
CLOUD_MINIO_ROOT_USER=replace-with-a-random-minio-access-key
CLOUD_MINIO_ROOT_PASSWORD=replace-with-a-long-random-minio-secret-key
CLOUD_MINIO_BUCKET=trinyx-cloud-files

KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.7.1
KEYCLOAK_REALM_NAME=trinyx
KEYCLOAK_FRONTEND_CLIENT_ID=trinyx-frontend
KEYCLOAK_ADMIN_CLIENT_ID=trinyx-admin-api
KEYCLOAK_ADMIN_CLIENT_SECRET=replace-with-a-long-random-keycloak-client-secret
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=replace-with-a-non-default-admin-name
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-admin-password

# Shared HMAC used by the repository's per-service GatewayAuthenticationFilter.
# The repository currently lacks the authenticated gateway that must generate
# these signatures; see docs/deployment/cloud.md before exposing Cloud.
CLOUD_GATEWAY_SECRET_KEY=replace-with-at-least-32-random-bytes
AUDIT_HMAC_KEY=replace-with-base64-encoded-32-plus-random-bytes
AUDIT_UA_PEPPER=replace-with-base64-encoded-32-plus-random-bytes
MODEL_AUDIT_HMAC_KEY=replace-with-a-long-random-model-audit-key
STORAGE_SHOWCASE_HMAC_SECRET=replace-with-at-least-32-random-bytes

CREDENTIAL_ENCRYPTION_PASSWORD=replace-with-a-long-random-encryption-password
CREDENTIAL_ENCRYPTION_SALT=replace-with-a-random-encryption-salt

# Cloud-specific Stripe TEST credentials only during validation. Never copy the
# paid-monolith credentials or Price IDs into this file or the repository.

SMTP_HOST=replace-with-smtp-host
SMTP_PORT=587
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=noreply@trinyx.fr

# Supply the real multiline signing material through the production secret
# manager. The values below exist only so docker compose config can render.
CATALOG_BUNDLE_SIGNING_KEY_PEM=replace-with-external-private-signing-key-pem
CATALOG_BUNDLE_SIGNING_PUBLIC_KEY=replace-with-external-public-signing-key-pem
CATALOG_BUNDLE_SIGNING_KEY_ID=trinyx-cloud-1
CATALOG_BUNDLE_ISSUER=trinyx-cloud

# Ed25519 public verification rings: kid=base64-X509;kid2=base64-X509.
# The matching private keys live only on the paid-monolith authority.
TRINYX_IDENTITY_VERIFICATION_KEYS=authority-identity-1=replace-with-base64-x509-public-key
TRINYX_ENTITLEMENT_VERIFICATION_KEYS=authority-entitlement-1=replace-with-base64-x509-public-key

# Separate Cloud workload signer used only for Cloud -> paid-monolith wallet calls.
# PKCS#8 private key is injected from the Cloud secret manager.
TRINYX_S2S_SIGNING_KID=cloud-runtime-1
TRINYX_S2S_SIGNING_KEY=replace-with-base64-pkcs8-private-key
PAID_MONOLITH_BILLING_URL=https://app.trinyx.fr

WEBSEARCH_GATEWAY_SECRET=replace-with-at-least-32-random-bytes
WEBSEARCH_CDP_JWT_SECRET=replace-with-at-least-32-random-bytes
SEARXNG_SECRET=replace-with-at-least-32-random-bytes

# Optional providers. Leave blank until configured externally.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=

# Required only for code nodes. No compatible implementation is present in this
# repository; point this at a separately operated, reviewed Piston-compatible API.
PISTON_URL=https://replace-with-compatible-code-service.example
