{
	# Keep HTTPS certificate automation active for the private tls-internal listener,
	# but never create an HTTP redirect listener.
	auto_https disable_redirects
	admin off
}

:8080 {
	encode zstd gzip

	# The authenticated Spring Cloud gateway is the only Cloud application edge.
	# It owns JWT validation, identity mapping, spoof-header stripping, routing,
	# and downstream HMAC v2 signing. Internal service APIs are denied there.
	reverse_proxy gateway-service:8086
}

:8180 {
	# Keycloak remains externally reachable only through auth.trinyx.fr.
	reverse_proxy keycloak:8080
}

https://{$CLOUD_INTERNAL_HOST:cloud-internal.trinyx.private}:8443 {
	tls internal

	# Private VPC-only S2S surface. Workload JWT validation remains mandatory
	# in auth-service; every other internal path is rejected here.
	@billing_ingest path /internal/v1/entitlement-projections /internal/v1/identity-bindings/revocations
	handle @billing_ingest {
		reverse_proxy auth-service:8083
	}
	respond 404
}
