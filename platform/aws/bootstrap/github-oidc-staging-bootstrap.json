{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Bootstrap GitHub Actions OIDC trust for Trinyx staging. This stack intentionally grants no AWS deployment permissions.",
  "Parameters": {
    "ExistingGitHubOidcProviderArn": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|^arn:aws:iam::[0-9]{12}:oidc-provider/token\\.actions\\.githubusercontent\\.com$",
      "Description": "Existing token.actions.githubusercontent.com IAM OIDC provider ARN. Leave empty to create it."
    },
    "PlatformWorkflowRef": {
      "Type": "String",
      "Default": "b5000a7167f12a555ca351c78af1079cabe4486c",
      "AllowedPattern": "^[0-9a-f]{40}$",
      "Description": "Reviewed immutable privileged reusable-workflow commit SHA embedded in GitHub custom OIDC subjects."
    }
  },
  "Conditions": {
    "CreateGitHubOidcProvider": {
      "Fn::Equals": [
        {
          "Ref": "ExistingGitHubOidcProviderArn"
        },
        ""
      ]
    }
  },
  "Resources": {
    "GitHubActionsOidcProvider": {
      "Type": "AWS::IAM::OIDCProvider",
      "Condition": "CreateGitHubOidcProvider",
      "Properties": {
        "Url": "https://token.actions.githubusercontent.com",
        "ClientIdList": [
          "sts.amazonaws.com"
        ],
        "Tags": [
          {
            "Key": "TrinyxManaged",
            "Value": "true"
          },
          {
            "Key": "TrinyxPurpose",
            "Value": "github-oidc"
          }
        ]
      }
    },
    "StagingGitHubOidcBootstrapRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "TrinyxStagingGitHubOidcBootstrapRole",
        "Description": "Identity-only bootstrap role for proving GitHub Actions OIDC trust before deployment permissions are introduced.",
        "MaxSessionDuration": 3600,
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Federated": {
                  "Fn::If": [
                    "CreateGitHubOidcProvider",
                    {
                      "Ref": "GitHubActionsOidcProvider"
                    },
                    {
                      "Ref": "ExistingGitHubOidcProviderArn"
                    }
                  ]
                }
              },
              "Action": "sts:AssumeRoleWithWebIdentity",
              "Condition": {
                "StringEquals": {
                  "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
                  "token.actions.githubusercontent.com:sub": {
                    "Fn::Sub": "repo:TrinyxAI@319253481/Trinyx@1342032975:environment:staging:ref:refs/heads/codex/platform-release-automation:job_workflow_ref:TrinyxAI/Trinyx/.github/workflows/staging-oidc-probe-impl.yml@${PlatformWorkflowRef}"
                  }
                }
              }
            }
          ]
        },
        "Tags": [
          {
            "Key": "TrinyxManaged",
            "Value": "true"
          },
          {
            "Key": "TrinyxEnvironment",
            "Value": "staging"
          },
          {
            "Key": "TrinyxPurpose",
            "Value": "github-oidc-bootstrap"
          }
        ]
      }
    }
  },
  "Outputs": {
    "GitHubOidcProviderArn": {
      "Description": "GitHub Actions OIDC provider ARN used by the bootstrap role.",
      "Value": {
        "Fn::If": [
          "CreateGitHubOidcProvider",
          {
            "Ref": "GitHubActionsOidcProvider"
          },
          {
            "Ref": "ExistingGitHubOidcProviderArn"
          }
        ]
      }
    },
    "StagingBootstrapRoleArn": {
      "Description": "Identity-only GitHub Actions OIDC bootstrap role ARN.",
      "Value": {
        "Fn::GetAtt": [
          "StagingGitHubOidcBootstrapRole",
          "Arn"
        ]
      }
    },
    "TrustedGitHubSubject": {
      "Description": "Exact immutable GitHub OIDC subject trusted by the bootstrap role.",
      "Value": {
        "Fn::Sub": "repo:TrinyxAI@319253481/Trinyx@1342032975:environment:staging:ref:refs/heads/codex/platform-release-automation:job_workflow_ref:TrinyxAI/Trinyx/.github/workflows/staging-oidc-probe-impl.yml@${PlatformWorkflowRef}"
      }
    },
    "RequiredGitHubOidcSubjectTemplate": {
      "Description": "GitHub repository OIDC subject customization required before live STS: immutable repository IDs, staging Environment, exact caller branch ref and called workflow identity.",
      "Value": "repo,context,ref,job_workflow_ref"
    }
  }
}
