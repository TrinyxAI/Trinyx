{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Least-privilege GitHub OIDC to SSM control plane for Trinyx staging deployments.",
  "Parameters": {
    "GitHubOidcProviderArn": {
      "Type": "String",
      "AllowedPattern": "^arn:aws:iam::[0-9]{12}:oidc-provider/token\\.actions\\.githubusercontent\\.com$"
    },
    "CloudInstanceId": {
      "Type": "String",
      "AllowedPattern": "^i-[0-9a-f]{17}$"
    },
    "PaidInstanceId": {
      "Type": "String",
      "AllowedPattern": "^i-[0-9a-f]{17}$"
    },
    "DocumentVersionName": {
      "Type": "String",
      "AllowedPattern": "^platform-[0-9a-f]{12}$",
      "Description": "Reviewed platform commit prefix used to identify the immutable SSM document version."
    },
    "PlatformWorkflowRef": {
      "Type": "String",
      "Default": "00fb3aef892d84754c8fb8d953171cb46fb05959",
      "AllowedPattern": "^[0-9a-f]{40}$",
      "Description": "Reviewed immutable privileged reusable-workflow commit SHA embedded in GitHub custom OIDC subjects."
    }
  },
  "Resources": {
    "StagingDeployDocument": {
      "Type": "AWS::SSM::Document",
      "Properties": {
        "Name": "Trinyx-Staging-Deploy",
        "DocumentType": "Command",
        "DocumentFormat": "JSON",
        "TargetType": "/AWS::EC2::Instance",
        "UpdateMethod": "NewVersion",
        "VersionName": {
          "Ref": "DocumentVersionName"
        },
        "Content": {
          "schemaVersion": "2.2",
          "description": "Run the fixed Trinyx staging deployment dispatcher. Arbitrary shell input is not accepted.",
          "parameters": {
            "Mode": {
              "type": "String",
              "allowedValues": [
                "install",
                "normalize-plan",
                "plan",
                "adopt",
                "restore-legacy",
                "apply",
                "rollback",
                "health"
              ],
              "interpolationType": "ENV_VAR"
            },
            "Role": {
              "type": "String",
              "allowedValues": [
                "cloud",
                "paid"
              ],
              "interpolationType": "ENV_VAR"
            },
            "ReleaseId": {
              "type": "String",
              "allowedPattern": "^rel-v1-[0-9a-f]{32}$",
              "interpolationType": "ENV_VAR"
            },
            "BundleDigest": {
              "type": "String",
              "allowedPattern": "^sha256:[0-9a-f]{64}$",
              "interpolationType": "ENV_VAR"
            },
            "RegistryBucket": {
              "type": "String",
              "allowedPattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$",
              "interpolationType": "ENV_VAR"
            },
            "DeploymentId": {
              "type": "String",
              "allowedPattern": "^dep-[0-9a-f]{32}$",
              "interpolationType": "ENV_VAR"
            },
            "EnvironmentConfigRevision": {
              "type": "String",
              "allowedPattern": "^[A-Za-z0-9._-]{1,128}$",
              "interpolationType": "ENV_VAR"
            },
            "PreviousCloudRelease": {
              "type": "String",
              "allowedPattern": "^$|^rel-v1-[0-9a-f]{32}$",
              "interpolationType": "ENV_VAR"
            },
            "PreviousPaidRelease": {
              "type": "String",
              "allowedPattern": "^$|^rel-v1-[0-9a-f]{32}$",
              "interpolationType": "ENV_VAR"
            },
            "ControlPlaneCommit": {
              "type": "String",
              "allowedPattern": "^[0-9a-f]{40}$",
              "interpolationType": "ENV_VAR"
            }
          },
          "mainSteps": [
            {
              "action": "aws:runShellScript",
              "name": "runTrinyxStagingDeploy",
              "inputs": {
                "timeoutSeconds": "900",
                "runCommand": [
                  "exec /usr/bin/env bash -c 'set -euo pipefail; test -x /usr/local/lib/trinyx/staging-deploy; exec /usr/local/lib/trinyx/staging-deploy \"$SSM_Mode\" \"$SSM_Role\" \"$SSM_ReleaseId\" \"$SSM_BundleDigest\" \"$SSM_RegistryBucket\" \"$SSM_DeploymentId\" \"$SSM_EnvironmentConfigRevision\" \"$SSM_ControlPlaneCommit\" \"$SSM_PreviousCloudRelease\" \"$SSM_PreviousPaidRelease\"'"
                ]
              }
            }
          ]
        },
        "Tags": [
          {
            "Key": "TrinyxManaged",
            "Value": "true"
          },
          {
            "Key": "TrinyxEnvironment",
            "Value": "staging"
          },
          {
            "Key": "TrinyxPurpose",
            "Value": "deployment-command"
          }
        ]
      }
    },
    "StagingDeployRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "TrinyxStagingDeployRole",
        "Description": "Least-privilege GitHub Actions role for the dedicated Trinyx staging SSM deployment document.",
        "MaxSessionDuration": 3600,
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Federated": {
                  "Ref": "GitHubOidcProviderArn"
                }
              },
              "Action": "sts:AssumeRoleWithWebIdentity",
              "Condition": {
                "StringEquals": {
                  "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
                  "token.actions.githubusercontent.com:sub": [
                    {
                      "Fn::Sub": "repo:TrinyxAI@319253481/Trinyx@1342032975:environment:staging:ref:refs/heads/codex/platform-release-automation:job_workflow_ref:TrinyxAI/Trinyx/.github/workflows/staging-qualification-impl.yml@${PlatformWorkflowRef}"
                    },
                    {
                      "Fn::Sub": "repo:TrinyxAI@319253481/Trinyx@1342032975:environment:staging:ref:refs/heads/codex/platform-release-automation:job_workflow_ref:TrinyxAI/Trinyx/.github/workflows/staging-legacy-adopt-impl.yml@${PlatformWorkflowRef}"
                    }
                  ]
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "TrinyxStagingSsmDeployOnly",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "SendOnlyDedicatedDocumentToStagingHosts",
                  "Effect": "Allow",
                  "Action": "ssm:SendCommand",
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:ssm:${AWS::Region}:${AWS::AccountId}:document/Trinyx-Staging-Deploy"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:ec2:${AWS::Region}:${AWS::AccountId}:instance/${CloudInstanceId}"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:ec2:${AWS::Region}:${AWS::AccountId}:instance/${PaidInstanceId}"
                    }
                  ]
                },
                {
                  "Sid": "ReadOwnCommandResult",
                  "Effect": "Allow",
                  "Action": "ssm:GetCommandInvocation",
                  "Resource": "*"
                },
                {
                  "Sid": "CoordinateOneNonSecretStagingDeployment",
                  "Effect": "Allow",
                  "Action": [
                    "ssm:PutParameter",
                    "ssm:GetParameter",
                    "ssm:DeleteParameter"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ssm:${AWS::Region}:${AWS::AccountId}:parameter/trinyx/staging/control-plane/deployment-lock"
                  }
                },
                {
                  "Sid": "InspectCommandsBeforeManualLockBreak",
                  "Effect": "Allow",
                  "Action": "ssm:ListCommands",
                  "Resource": "*"
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "TrinyxManaged",
            "Value": "true"
          },
          {
            "Key": "TrinyxEnvironment",
            "Value": "staging"
          },
          {
            "Key": "TrinyxPurpose",
            "Value": "github-deploy"
          }
        ]
      }
    }
  },
  "Outputs": {
    "StagingDeployRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "StagingDeployRole",
          "Arn"
        ]
      }
    },
    "StagingDeployDocumentName": {
      "Value": {
        "Ref": "StagingDeployDocument"
      }
    },
    "StagingDeployDocumentVersionName": {
      "Value": {
        "Ref": "DocumentVersionName"
      }
    },
    "CloudInstanceId": {
      "Value": {
        "Ref": "CloudInstanceId"
      }
    },
    "PaidInstanceId": {
      "Value": {
        "Ref": "PaidInstanceId"
      }
    },
    "RequiredGitHubOidcSubjectTemplate": {
      "Value": "repo,context,ref,job_workflow_ref"
    },
    "StagingDeployOidcSubjects": {
      "Value": {
        "Fn::Join": [
          ",",
          [
            {
              "Fn::Sub": "repo:TrinyxAI@319253481/Trinyx@1342032975:environment:staging:ref:refs/heads/codex/platform-release-automation:job_workflow_ref:TrinyxAI/Trinyx/.github/workflows/staging-qualification-impl.yml@${PlatformWorkflowRef}"
            },
            {
              "Fn::Sub": "repo:TrinyxAI@319253481/Trinyx@1342032975:environment:staging:ref:refs/heads/codex/platform-release-automation:job_workflow_ref:TrinyxAI/Trinyx/.github/workflows/staging-legacy-adopt-impl.yml@${PlatformWorkflowRef}"
            }
          ]
        ]
      }
    }
  }
}
