{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trinyx.ai/contracts/staging-deployment-record-v1.json",
  "title": "Trinyx staging deployment record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "deploymentId",
    "environment",
    "releaseId",
    "environmentConfigRevision",
    "controlPlaneCommit",
    "previousCloudRelease",
    "previousPaidRelease",
    "state",
    "createdAt",
    "startedAt",
    "completedAt",
    "failure",
    "rollbackResult",
    "history"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "deploymentId": {
      "type": "string",
      "pattern": "^dep-[0-9a-f]{32}$"
    },
    "environment": {
      "const": "staging"
    },
    "releaseId": {
      "type": "string",
      "pattern": "^rel-v1-[0-9a-f]{32}$"
    },
    "environmentConfigRevision": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,128}$"
    },
    "previousCloudRelease": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^rel-v1-[0-9a-f]{32}$"
    },
    "previousPaidRelease": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^rel-v1-[0-9a-f]{32}$"
    },
    "state": {
      "enum": [
        "CREATED",
        "PREFLIGHT",
        "READY",
        "MIGRATING",
        "ACTIVATING",
        "HEALTH_CHECKING",
        "SUCCESS",
        "ROLLING_BACK",
        "ROLLED_BACK",
        "FAILED",
        "ROLLBACK_FAILED",
        "MANUAL_RECOVERY_REQUIRED"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "startedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "completedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "failure": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 512
    },
    "rollbackResult": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "state",
          "at"
        ],
        "properties": {
          "state": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "controlPlaneCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    }
  }
}
