{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trinyx.ai/contracts/health-endpoints.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "checks"],
  "properties": {
    "schemaVersion": {"const": 1},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "url", "expectedStatuses", "timeoutSeconds", "caFile"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
          "url": {"type": "string", "pattern": "^https://"},
          "expectedStatuses": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 100, "maximum": 599}},
          "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 30},
          "caFile": {"type": "string", "pattern": "^/etc/trinyx/staging/.+\\.pem$"}
        }
      }
    }
  }
}
