{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trinyx.ai/contracts/legacy-normalization-plan.schema.json",
  "title": "Trinyx Staging Legacy Runtime Normalization Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "environment",
    "role",
    "baselineReleaseId",
    "bundleDigest",
    "deploymentId",
    "environmentConfigRevision",
    "environmentConfigDigest",
    "controlPlaneCommit",
    "observedAt",
    "composeProject",
    "composeVersion",
    "composeHashCapability",
    "composeHashCompatibility",
    "composeHashCalibrationMatches",
    "composeHashCalibrationTotal",
    "composeHashMismatchCount",
    "composeHashMismatchLimit",
    "imageCompatibility",
    "serviceCount",
    "recreateServices",
    "services"
  ],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "environment": {
      "const": "staging"
    },
    "role": {
      "enum": [
        "cloud",
        "paid"
      ]
    },
    "baselineReleaseId": {
      "type": "string",
      "pattern": "^rel-v1-[0-9a-f]{32}$"
    },
    "bundleDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "deploymentId": {
      "type": "string",
      "pattern": "^dep-[0-9a-f]{32}$"
    },
    "environmentConfigRevision": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,128}$"
    },
    "environmentConfigDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "controlPlaneCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "composeProject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "composeVersion": {
      "type": "string",
      "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
    },
    "composeHashCapability": {
      "const": "SUPPORTED"
    },
    "composeHashCompatibility": {
      "enum": [
        "QUALIFIED_REVIEW",
        "UNQUALIFIED_EXCESSIVE_DRIFT"
      ]
    },
    "composeHashCalibrationMatches": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20
    },
    "composeHashCalibrationTotal": {
      "enum": [
        8,
        20
      ]
    },
    "composeHashMismatchCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20
    },
    "composeHashMismatchLimit": {
      "const": 3
    },
    "imageCompatibility": {
      "enum": [
        "MATCHED",
        "MISMATCH"
      ]
    },
    "serviceCount": {
      "enum": [
        8,
        20
      ]
    },
    "recreateServices": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "services": {
      "type": "object",
      "minProperties": 8,
      "maxProperties": 20,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "currentContainerId",
          "currentConfiguredImage",
          "currentImageObjectId",
          "currentRepoDigests",
          "imageObjectVerified",
          "configuredImageCanonical",
          "imageContentMatches",
          "expectedImageDigest",
          "currentComposeConfigHash",
          "expectedComposeConfigHash",
          "currentMounts",
          "expectedMounts",
          "mutableCheckoutMounted",
          "recreateRequired",
          "reasons"
        ],
        "properties": {
          "currentContainerId": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "currentConfiguredImage": {
            "type": "string",
            "pattern": "^[^\\s\\u0000-\\u001f\\u007f]{1,4096}$"
          },
          "currentImageObjectId": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "expectedImageDigest": {
            "type": "string",
            "pattern": "^[^@\\s]+@sha256:[0-9a-f]{64}$"
          },
          "currentComposeConfigHash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "expectedComposeConfigHash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "currentMounts": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/mount"
            }
          },
          "expectedMounts": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/mount"
            }
          },
          "mutableCheckoutMounted": {
            "type": "boolean"
          },
          "recreateRequired": {
            "type": "boolean"
          },
          "reasons": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "IMAGE_REFERENCE_NON_CANONICAL",
                "IMAGE_OBJECT_DIGEST_MISMATCH",
                "COMPOSE_CONFIG_HASH_MISMATCH",
                "BIND_MOUNT_MISMATCH",
                "MUTABLE_CHECKOUT_MOUNT"
              ]
            }
          },
          "currentRepoDigests": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[^@\\s]+@sha256:[0-9a-f]{64}$"
            }
          },
          "imageObjectVerified": {
            "const": true
          },
          "configuredImageCanonical": {
            "type": "boolean"
          },
          "imageContentMatches": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "$defs": {
    "mount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "source",
        "destination",
        "readOnly"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "maxLength": 4096
        },
        "destination": {
          "type": "string",
          "pattern": "^/",
          "maxLength": 4096
        },
        "readOnly": {
          "type": "boolean"
        }
      }
    }
  }
}
